{
  "name": "@toneflix/studio",
  "version": "0.1.0",
  "description": "A browser DAW timeline: stems, freely movable clips, canvas waveforms and one undo history.",
  "license": "MIT",
  "author": "Toneflix <code@toneflix.com.ng>",
  "repository": {
    "type": "git",
    "url": "https://github.com/toneflix/studio.git"
  },
  "keywords": [
    "daw",
    "audio",
    "waveform",
    "timeline",
    "web-audio",
    "music"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "test": "node --test \"test/**/*.test.ts\"",
    "demo": "vite demo"
  },
  "homepage": "https://github.com/toneflix/studio#readme",
  "bugs": {
    "url": "https://github.com/toneflix/studio/issues"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.19.11",
    "eslint": "^10.13.0",
    "globals": "^17.4.0",
    "typescript": "^6.0.0",
    "typescript-eslint": "^8.46.0",
    "vite": "^8.3.0"
  },
  "engines": {
    "node": ">=22.18"
  },
  "packageManager": "yarn@1.22.22",
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
