{
  "name": "@toneflix/studio-audio",
  "version": "0.3.1",
  "description": "Playback for Toneflix Studio: plays a multitrack timeline with Web Audio, with a mixer, effects, loops, a metronome and offline mixdown.",
  "license": "MIT",
  "author": "Toneflix <code@toneflix.com.ng>",
  "repository": {
    "type": "git",
    "url": "https://github.com/toneflix/studio.git",
    "directory": "packages/audio"
  },
  "homepage": "https://toneflix.github.io/studio/",
  "bugs": {
    "url": "https://github.com/toneflix/studio/issues"
  },
  "keywords": [
    "web-audio",
    "playback",
    "mixer",
    "daw",
    "metronome"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "@toneflix/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@toneflix/studio-core": "workspace:^"
  },
  "engines": {
    "node": ">=22.18"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
