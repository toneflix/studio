{
  "name": "@toneflix/studio-controls",
  "version": "0.3.1",
  "description": "Ready-made controls for Toneflix Studio: a transport and editing toolbar and track strips with mute, solo and volume, drawn with Lucide icons you can replace.",
  "license": "MIT",
  "author": "Toneflix <code@toneflix.com.ng>",
  "repository": {
    "type": "git",
    "url": "https://github.com/toneflix/studio.git",
    "directory": "packages/controls"
  },
  "homepage": "https://toneflix.github.io/studio/",
  "bugs": {
    "url": "https://github.com/toneflix/studio/issues"
  },
  "keywords": [
    "daw",
    "toolbar",
    "transport",
    "icons",
    "lucide"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "@toneflix/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@toneflix/studio-audio": "workspace:^",
    "@toneflix/studio-core": "workspace:^",
    "@toneflix/studio-timeline": "workspace:^"
  },
  "engines": {
    "node": ">=22.18"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
